{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/school-api/src",
  "entryFile": "apps/school-api/src/main",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.build.json",
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": { "dtoFileNameSuffix": [".dto.ts", ".entity.ts"], "classValidatorShim": true }
      }
    ]
  }
}
