NODE_ENV=development
HOST=::
PORT=3000
APP_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=
PUBLIC_BASE_URL=

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=telematics
DB_SSL=false
DB_POOL_SIZE=10

JWT_ACCESS_SECRET=generate-48-random-bytes-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=3600
REFRESH_TTL_DAYS=30

OTP_MODE=test
OTP_TEST_CODE=123456
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30
OTP_MAX_PER_WINDOW=5
OTP_WINDOW_MINUTES=15

SMS_DRIVER=log
OTP_SMS_DRIVER=ping4sms
PING_API_KEY=
PING_ROUTE=
PING_SENDER=
PING_OTP_TEMPLATE_ID=

NOTIFY_KAFKA_BROKER=
NOTIFY_KAFKA_USER=
NOTIFY_KAFKA_PASSWORD=
NOTIFY_KAFKA_SSL=false
NOTIFY_KAFKA_TOPIC=notifications
NOTIFY_KAFKA_CLIENT_ID=school-api
NOTIFY_TENANT_ID=
NOTIFY_TEMPLATE_PREFIX=school_
NOTIFY_KAFKA_LOG=false

PUSH_DRIVER=off
FIREBASE_CREDENTIALS_FILE=

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
FILE_MAX_MB=10
FILE_URL_TTL_SECONDS=3600
FILE_SIGNING_SECRET=generate-48-random-bytes-at-least-32-characters
QR_SIGNING_SECRET=generate-48-random-bytes-at-least-32-characters
DATA_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32
VIRUS_SCAN=off

QUEUE_DRIVER=memory
QUEUE_MAX_RETRIES=3

TELEMATICS_API_URL=http://localhost:3001/api/v1
TELEMATICS_API_KEY=paste-one-key-from-API_KEYS-in-telematics-service-.env
TELEMATICS_TIMEOUT_MS=5000
